    "Enter a complete website or app URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete website or app URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webサイトまたはアプリの完全なURLを入力してください。"
