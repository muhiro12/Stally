          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録日時：%@"
          }
        }
      }
    },
    "Reload this record before editing it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload this record before editing it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を読み込み直してから編集してください。"
          }
        }
      }
    },
    "Resolve missing relationships or conflicting identities before transferring.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve missing relationships or conflicting identities before transferring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込みや書き出しの前に、参照先の欠落や識別情報の競合を解消してください。"
          }
        }
      }
    },
    "Resume Mark recording before adding an occurrence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume Mark recording before adding an occurrence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マークの記録を再開してから追加してください。"
          }
        }
      }
    },
    "Review the existing ongoing period before starting another.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the existing ongoing period before starting another."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい期間を開始する前に、既存の継続中の期間を確認してください。"
          }
        }
      }
    },
    "Samples can only be added to the local development store.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samples can only be added to the local development store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルはローカルの開発用保存先にのみ追加できます。"
          }
        }
      }
    },
    "Samples can only be added when all development records are empty.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samples can only be added when all development records are empty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルは開発用の記録がすべて空の場合にのみ追加できます。"
          }
        }
      }
    },
    "The file is incomplete, damaged, or is not a Stally export.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is incomplete, damaged, or is not a Stally export."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが不完全か破損しているか、Stallyの書き出しファイルではありません。"
          }
        }
      }
    },
    "The library changed. Review the import again before saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library changed. Review the import again before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリが変更されました。保存前に取り込み内容をもう一度確認してください。"
          }
        }
      }
    },
    "The period has inconsistent boundaries or continuation state.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The period has inconsistent boundaries or continuation state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間の開始・終了または継続状態に矛盾があります。"
          }
        }
      }
    },
    "The shared Stally container is unavailable. Check App Group signing and reopen Stally.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared Stally container is unavailable. Check App Group signing and reopen Stally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stallyの共有保存先を利用できません。App Groupの署名設定を確認してから、Stallyを開き直してください。"
          }
        }
      }
    },
    "These periods definitely overlap. Review their boundaries.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These periods definitely overlap. Review their boundaries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの期間には確実な重複があります。開始・終了を確認してください。"
          }
        }
      }
    },
    "This file cannot be imported by this version of Stally.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be imported by this version of Stally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは、お使いのバージョンのStallyでは取り込めません。"
          }
        }
      }
    },
    "This image is not a supported complete still image within the saved limits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image is not a supported complete still image within the saved limits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応する静止画像ではないか、画像が不完全、または保存上限を超えています。"
          }
        }
      }
    },
    "This record is no longer available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record is no longer available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録は利用できなくなりました。"
          }
        }
      }
    },
    "This transfer exceeds the supported size limits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transfer exceeds the supported size limits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは対応するサイズの上限を超えています。"
          }
        }
      }
    },
    "Unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明"
          }
        }
      }
    },
    "The records changed. Review this operation again before saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The records changed. Review this operation again before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が変更されました。保存前にこの操作の内容をもう一度確認してください。"
          }
        }
      }
    },
    "The iCloud account changed. Reopen the record or review before saving.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud account changed. Reopen the record or review before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudアカウントが変更されました。保存する前に、記録または読み込み内容の確認画面を開き直してください。"
          }
        }
      }
    },
    "This period has already ended.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This period has already ended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間はすでに終了しています。"
          }
        }
      }
    },
    "Apple Intelligence does not support this language for input assistance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence does not support this language for input assistance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この言語ではApple Intelligenceの入力補助を利用できません。"
          }
        }
      }
    },
    "Apple Intelligence is still preparing. Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is still preparing. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceは準備中です。しばらくしてから再度お試しください。"
          }
        }
      }
    },
    "Could not prepare a suggestion. Try again or enter the Item manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare a suggestion. Try again or enter the Item manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力案を作成できませんでした。再度お試しいただくか、手入力してください。"
          }
        }
      }
    },
    "Enter a description of one Item.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a description of one Item."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのアイテムについて説明を入力してください。"
          }
        }
      }
    },
    "Input assistance is currently unavailable. You can enter the Item manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input assistance is currently unavailable. You can enter the Item manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、入力補助は利用できません。アイテムは手入力できます。"
          }
        }
      }
    },
    "Input assistance requires a device that supports Apple Intelligence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input assistance requires a device that supports Apple Intelligence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力補助にはApple Intelligence対応の端末が必要です。"
          }
        }
      }
    },
    "No reliable Item suggestion was found. Describe one Item more clearly and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reliable Item suggestion was found. Describe one Item more clearly and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の文章に沿った入力案を作成できませんでした。1つのアイテムについて、より具体的に説明して再度お試しください。"
          }
        }
      }
    },
    "This description could not be processed. Try different wording or enter the Item manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This description could not be processed. Try different wording or enter the Item manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この説明は処理できませんでした。表現を変えてお試しいただくか、手入力してください。"
          }
        }
      }
    },
    "Turn on Apple Intelligence in Settings to use input assistance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in Settings to use input assistance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力補助を使うには、設定でApple Intelligenceをオンにしてください。"
          }
        }
      }
    },
    "Use a shorter description, up to 4,000 characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a shorter description, up to 4,000 characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明を4,000文字以内に短くしてください。"
          }
        }
      }
    }
  },
  "version": "1.3"
}
