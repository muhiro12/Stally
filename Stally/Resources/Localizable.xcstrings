        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出した写真には、位置情報など、元の写真に含まれるメタデータが残ります。"
          }
        }
      }
    },
    "Exports all Items, including archived records and unused Tags.": {
