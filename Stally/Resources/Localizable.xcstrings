    "Export records as JSON for use in other apps. Image files are not included. For import into Stally, use the file promptly after export. Future versions may not support older files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export records as JSON for use in other apps. Image files are not included. For import into Stally, use the file promptly after export. Future versions may not support older files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を外部アプリで利用するためにJSON形式で書き出します。画像ファイルは含まれません。Stallyに取り込む場合は、書き出し後、速やかに取り込んでください。将来のバージョンでは、過去に書き出したファイルに対応しない場合があります。"
          }
        }
      }
    },
    "Export records for use in other apps or device transfer. For import into Stally, use the file promptly after export. Future versions may not support older files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export records for use in other apps or device transfer. For import into Stally, use the file promptly after export. Future versions may not support older files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を外部アプリで利用したり、別の端末へ移行したりするために書き出します。Stallyに取り込む場合は、書き出し後、速やかに取り込んでください。将来のバージョンでは、過去に書き出したファイルに対応しない場合があります。"
          }
        }
      }
    },
    "Export records for use in other apps or transfer to another device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export records for use in other apps or transfer to another device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を外部アプリで利用したり、別の端末へ移行したりするために書き出します。"
          }
        }
      }
    },
    "Exported photos retain embedded metadata, including location when present.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported photos retain embedded metadata, including location when present."
